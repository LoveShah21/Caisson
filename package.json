{
  "name": "caisson",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "bootstrap:policy": "node scripts/bootstrap-policy.mjs",
    "bootstrap:services": "node scripts/bootstrap-services.mjs",
    "build:minio": "node scripts/build-minio-image.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:runtime-versions": "node scripts/check-runtime-versions.mjs",
    "check:runtime-rootfs": "node scripts/check-runtime-rootfs-inventory.mjs guest/rootfs/caisson-runtime-rootfs.ext4",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "turbo run lint",
    "policy:test": "node scripts/test-policy.mjs",
    "test": "pnpm test:invariant-lint && turbo run test && vitest run tests",
    "test:invariant-lint": "node scripts/check-invariant-tests.mjs",
    "test:wsl2": "pnpm exec vitest run --pool=threads --reporter=verbose tests/invariants/INV-7.spec.ts tests/isolation/m1-driver-mechanism.spec.ts tests/isolation/firecracker-runtime.integration.spec.ts tests/guest/runtime-rootfs-inventory.spec.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.10.0",
    "postgres": "^3.4.9",
    "testcontainers": "^12.1.0",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
