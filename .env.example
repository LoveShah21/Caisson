CAISSON_POSTGRES_PASSWORD=caisson-postgres-local-only
CAISSON_CLICKHOUSE_PASSWORD=caisson-clickhouse-local-only
CAISSON_MINIO_USER=caisson
CAISSON_MINIO_PASSWORD=caisson-minio-local-only
CAISSON_MINIO_KMS_SECRET_KEY=dev-snapshot-kms-key:replace-with-base64-encoded-32-byte-key
CAISSON_SNAPSHOT_MANIFEST_KEY_ID=dev-manifest-key-1
CAISSON_SNAPSHOT_MANIFEST_HMAC_KEY=replace-with-base64-encoded-32-byte-key
CAISSON_SNAPSHOT_CACHE_MAX_BYTES=replace-with-cache-size-in-bytes
# Development-only PostgreSQL adapter limits. Production must set its own values.
CAISSON_POSTGRES_STATEMENT_TIMEOUT_MS=1000
CAISSON_POSTGRES_ROW_LIMIT=1000
CAISSON_POSTGRES_RESULT_SIZE_BYTES=1048576
