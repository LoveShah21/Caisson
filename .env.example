CAISSON_POSTGRES_PASSWORD=caisson-postgres-local-only
CAISSON_CLICKHOUSE_PASSWORD=caisson-clickhouse-local-only
CAISSON_MINIO_USER=caisson
CAISSON_MINIO_PASSWORD=caisson-minio-local-only
CAISSON_MINIO_KMS_SECRET_KEY=dev-snapshot-kms-key:replace-with-base64-encoded-32-byte-key
CAISSON_SNAPSHOT_MANIFEST_KEY_ID=dev-manifest-key-1
CAISSON_SNAPSHOT_MANIFEST_HMAC_KEY=replace-with-base64-encoded-32-byte-key
CAISSON_SNAPSHOT_CACHE_MAX_BYTES=replace-with-cache-size-in-bytes
CAISSON_SESSION_SNAPSHOT_RETENTION_MS=replace-with-retention-duration-in-ms
CAISSON_SESSION_SNAPSHOT_RETENTION_COUNT=replace-with-retained-snapshot-count
CAISSON_SESSION_SNAPSHOT_DRAIN_TIMEOUT_MS=replace-with-action-drain-timeout-in-ms
# Development-only env SecretBackend value. Production uses a Vault reference.
CAISSON_SESSION_SNAPSHOT_ROOT_KEK={"kind":"snapshot_kek","keyId":"dev-session-snapshot-kek-1","key":"replace-with-base64-encoded-32-byte-key"}
# Development-only PostgreSQL adapter limits. Production must set its own values.
CAISSON_POSTGRES_STATEMENT_TIMEOUT_MS=1000
CAISSON_POSTGRES_ROW_LIMIT=1000
CAISSON_POSTGRES_RESULT_SIZE_BYTES=1048576
# Development-only HTTP adapter configuration. Production must provide its own allowlist and limits.
CAISSON_HTTP_ALLOWLIST=https://api.example.test/v1
CAISSON_HTTP_ALLOWED_PORTS=443
CAISSON_HTTP_TIMEOUT_MS=5000
CAISSON_HTTP_REQUEST_SIZE_BYTES=1048576
CAISSON_HTTP_RESPONSE_SIZE_BYTES=1048576
CAISSON_HTTP_RESPONSE_HEADER_BYTES=32768
# Development-only S3 adapter configuration. The endpoint is host-side only.
CAISSON_S3_ENDPOINT=http://minio:9000
CAISSON_S3_REGION=us-east-1
CAISSON_S3_FORCE_PATH_STYLE=true
CAISSON_S3_ALLOWLIST=example-bucket:allowed/
CAISSON_S3_TIMEOUT_MS=5000
CAISSON_S3_OBJECT_SIZE_BYTES=10485760
CAISSON_S3_LIST_LIMIT=1000
