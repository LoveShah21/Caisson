{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CAISSON_BENCH_IMAGE", "CAISSON_BENCH_SAMPLES"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
