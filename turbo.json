{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CAISSON_BENCH_IMAGE",
    "CAISSON_BENCH_DRIVER",
    "CAISSON_BENCH_FIRECRACKER",
    "CAISSON_BENCH_SAMPLES",
    "CAISSON_ENV",
    "CAISSON_MANUAL_FC_TEST",
    "CAISSON_FIRECRACKER_BIN",
    "CAISSON_FIRECRACKER_KERNEL",
    "CAISSON_FIRECRACKER_ROOTFS",
    "CAISSON_FIRECRACKER_RUNTIME_DIR",
    "CAISSON_FIRECRACKER_SNAPSHOT_DIR",
    "CAISSON_RUNTIME_KVM_TESTS",
    "CAISSON_AGENT_RUNTIME_DIAGNOSTIC_ROOTFS"
  ],
  "globalPassThroughEnv": [
    "CAISSON_BENCH_SNAPSHOT_STORE",
    "CAISSON_SNAPSHOT_ENDPOINT",
    "CAISSON_SNAPSHOT_REGION",
    "CAISSON_SNAPSHOT_BUCKET",
    "CAISSON_SNAPSHOT_CACHE_DIR",
    "CAISSON_SNAPSHOT_CACHE_MAX_BYTES",
    "CAISSON_SNAPSHOT_MANIFEST_KEY_ID",
    "CAISSON_SNAPSHOT_MANIFEST_HMAC_KEY",
    "CAISSON_MINIO_USER",
    "CAISSON_MINIO_PASSWORD",
    "CAISSON_INV7_FIRECRACKER",
    "CAISSON_INV7_FIRECRACKER_ROOTFS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
